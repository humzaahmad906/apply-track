<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ r.basics.name or "Resume" }}</title>
<style>
  /* Sizes and spacing follow mainstream resume formatting guidance: name
     18-24pt, section headings 12-14pt bold, body 10-12pt, margins 0.5-1in,
     line spacing 1.0-1.15, at most two font families, single column.

     Font stacks are restricted to families that ship stock on BOTH macOS and
     Windows, so the same JSON renders the same on either machine. Calibri,
     Cambria, Garamond and Aptos are all recommended for resumes but arrive
     with Microsoft Office rather than the OS, so they are not safe defaults.
     Georgia is deliberately avoided: its digits are old-style figures that sit
     at x-height, which makes dates and metrics look misaligned. */
  @page { size: {{ page_size }}; margin: {{ margin }}; }

  :root {
{% if font == "serif" %}
    --font: "Times New Roman", Times, serif;
{% else %}
    --font: Helvetica, Arial, sans-serif;
{% endif %}
    --ink: #111;
    --muted: #444;
    --rule: #9a9a9a;
    --body: 10.5pt;
    /* Guidance puts resume line spacing at 1.0-1.15. Separation between
       entries comes from .item margins instead, so lines inside a bullet stay
       tight and more content fits the page. */
    --lh: 1.15;
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; padding: 0; }

  body {
    font-family: var(--font);
    font-size: var(--body);
    line-height: var(--lh);
    color: var(--ink);
    /* Lining figures where the family offers a choice, so digits align. */
    font-variant-numeric: lining-nums tabular-nums;
    -webkit-font-smoothing: antialiased;
  }

  /* Screen-only: mimic a sheet of paper. @page owns the real PDF margins. */
  .sheet { max-width: 7.4in; margin: 0 auto; }
  @media screen {
    body { background: #f2f2f2; padding: 24px 12px; }
    .sheet { background: #fff; padding: 0.55in 0.6in; box-shadow: 0 1px 6px rgba(0,0,0,.18); }
  }

  header { margin-bottom: 11pt; }

  h1 {
    font-size: 20pt;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 3pt;
    font-weight: 700;
  }

  .headline {
    font-size: 11pt;
    color: var(--muted);
    margin: 0 0 4pt;
  }

  .contact { font-size: 9.5pt; color: var(--muted); }
  .contact span + span::before { content: "  •  "; color: var(--rule); }
  .contact a { color: inherit; text-decoration: none; }

  .summary { margin: 7pt 0 0; }

  h2 {
    font-size: 12pt;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: 700;
    margin: 12pt 0 5pt;
    padding-bottom: 2pt;
    border-bottom: 1pt solid var(--rule);
    /* Never strand a heading alone at the foot of a page. */
    break-after: avoid;
    page-break-after: avoid;
  }

  section { break-inside: auto; }

  /* A long entry must be allowed to flow across a page boundary. Marking the
     whole .item unbreakable meant anything taller than the space left got
     pushed wholesale to the next page, leaving inches of blank paper. */
  .item { margin-bottom: 7pt; break-inside: auto; }
  .item:last-child { margin-bottom: 0; }

  .item-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10pt;
    /* Keep the job title attached to at least its first bullet. */
    break-after: avoid;
    page-break-after: avoid;
    break-inside: avoid;
  }

  .item-title { font-weight: 700; }
  .item-title a { color: inherit; text-decoration: none; }

  /* Employer is load-bearing information, so it stays upright rather than
     italic -- ATS guidance advises against italics for important fields. */
  .item-sub { color: var(--muted); }

  .item-meta {
    font-size: 9.5pt;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* pre-line keeps the paragraph breaks when an entry's prose spans more than
     one paragraph, without letting a long line overflow the column. */
  .item-desc { margin: 2pt 0 0; white-space: pre-line; }

  ul { margin: 2pt 0 0; padding-left: 14pt; break-inside: auto; }
  /* Chromium ignores the orphans and widows properties, so guard the unit that
     actually matters: a single bullet must never be torn across two pages. */
  li { margin-bottom: 1.5pt; break-inside: avoid; page-break-inside: avoid; }
  li:last-child { margin-bottom: 0; }

  .tag-group { display: flex; gap: 5pt; }
  .tag-label { font-weight: 700; white-space: nowrap; }

  /* Repeating continuation header. A thead is the one construct Chromium
     repeats across page breaks; Chromium has no @page margin boxes. Table
     structure does not survive into an untagged PDF, so a parser sees plain
     positioned text rather than a table. Convention: one line, smaller than
     the page-1 name, carrying name + one contact + "Page N of M". */
  table.flow { width: 100%; border-collapse: collapse; }
  table.flow > tbody > tr > td { padding: 0; }
  .runhead {
    font-size: 9pt;
    font-weight: 400;
    color: var(--muted);
    text-align: left;
    padding: 0 0 5pt;
    border-bottom: 0.5pt solid var(--rule);
  }
</style>
</head>
<body>
<div class="sheet">
{% if running_header %}
<table class="flow">
  <thead>
    <tr><th class="runhead">{{ running_header }}</th></tr>
  </thead>
  <tbody><tr><td>
{% endif %}

  <header>
    {% if r.basics.name %}<h1>{{ r.basics.name }}</h1>{% endif %}
    {% if r.basics.headline %}<p class="headline">{{ r.basics.headline }}</p>{% endif %}
    <div class="contact">
      {%- if r.basics.location %}<span>{{ r.basics.location }}</span>{% endif -%}
      {%- if r.basics.phone %}<span>{{ r.basics.phone }}</span>{% endif -%}
      {%- if r.basics.email %}<span><a href="mailto:{{ r.basics.email }}">{{ r.basics.email }}</a></span>{% endif -%}
      {%- for link in r.basics.links %}
        {%- if link.url %}<span><a href="{{ link.url | href }}">{{ link.label or link.url }}</a></span>{% endif -%}
      {%- endfor -%}
    </div>
    {% if r.basics.summary %}<p class="summary">{{ r.basics.summary }}</p>{% endif %}
  </header>

  {% for s in r.sections %}
  <section>
    <h2>{{ s.title or s.kind|title }}</h2>

    {% if s.kind == "skills" %}
      {% for item in s.items %}
      <div class="item">
        {% if item.tags %}
          <div class="tag-group">
            {% if item.title %}<span class="tag-label">{{ item.title }}:</span>{% endif %}
            <span>{{ item.tags|join(", ") }}</span>
          </div>
        {% elif item.title %}
          <div class="item-title">{{ item.title }}</div>
        {% endif %}
        {% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}
        {% if item.bullets %}
        <ul>{% for b in item.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
        {% endif %}
      </div>
      {% endfor %}

    {% else %}
      {% for item in s.items %}
      <div class="item">
        <div class="item-head">
          <div>
            <span class="item-title">
              {%- if item.url %}<a href="{{ item.url | href }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif -%}
            </span>
            {%- if item.subtitle %} — <span class="item-sub">{{ item.subtitle }}</span>{% endif -%}
          </div>
          {% set dates = item | daterange %}
          {% if dates or item.location %}
          <div class="item-meta">
            {{- dates -}}
            {%- if dates and item.location %} · {% endif -%}
            {{- item.location -}}
          </div>
          {% endif %}
        </div>
        {% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}
        {% if item.tags %}<p class="item-desc">{{ item.tags|join(", ") }}</p>{% endif %}
        {% if item.bullets %}
        <ul>{% for b in item.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
        {% endif %}
      </div>
      {% endfor %}
    {% endif %}
  </section>
  {% endfor %}

{% if running_header %}
  </td></tr></tbody>
</table>
{% endif %}
</div>
</body>
</html>
