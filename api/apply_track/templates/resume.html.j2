<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ r.basics.name or "Resume" }}</title>
<style>
  /* Font stacks deliberately limited to families present on both macOS and
     Windows, so the same JSON renders the same on either machine. */
  @page { size: {{ page_size }}; margin: {{ margin }}; }

  :root {
    --ink: #111;
    --muted: #4a4a4a;
    --rule: #b8b8b8;
    --body: 10.5pt;
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; padding: 0; }

  body {
    font-family: Georgia, "Times New Roman", serif;
    font-size: var(--body);
    line-height: 1.4;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  /* Only applies to the on-screen preview; @page owns the PDF margins. */
  .sheet { max-width: 7.5in; margin: 0 auto; padding: 0; }
  @media screen {
    body { background: #f2f2f2; padding: 24px 12px; }
    .sheet { background: #fff; padding: 0.6in 0.7in; box-shadow: 0 1px 6px rgba(0,0,0,.18); }
  }

  header { margin-bottom: 10pt; }

  h1 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 19pt;
    letter-spacing: .01em;
    margin: 0 0 2pt;
    font-weight: 700;
  }

  .headline {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10.5pt;
    color: var(--muted);
    margin: 0 0 4pt;
  }

  .contact {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9pt;
    color: var(--muted);
  }
  .contact span + span::before { content: "  •  "; color: var(--rule); }
  .contact a { color: inherit; text-decoration: none; }

  .summary { margin: 8pt 0 0; }

  h2 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10pt;
    text-transform: uppercase;
    letter-spacing: .09em;
    font-weight: 700;
    margin: 13pt 0 5pt;
    padding-bottom: 2pt;
    border-bottom: .75pt solid var(--rule);
  }

  section { break-inside: auto; }

  .item { margin-bottom: 7pt; break-inside: avoid; }
  .item:last-child { margin-bottom: 0; }

  .item-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10pt;
  }

  .item-title { font-weight: 700; }
  .item-title a { color: inherit; text-decoration: none; }

  .item-sub { font-style: italic; color: var(--muted); }

  .item-meta {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9pt;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .item-desc { margin: 2pt 0 0; }

  ul { margin: 3pt 0 0; padding-left: 15pt; }
  li { margin-bottom: 1.5pt; }
  li:last-child { margin-bottom: 0; }

  .tags { margin-top: 1pt; }
  .tag-group { display: flex; gap: 6pt; }
  .tag-label { font-weight: 700; white-space: nowrap; }
</style>
</head>
<body>
<div class="sheet">

  <header>
    {% if r.basics.name %}<h1>{{ r.basics.name }}</h1>{% endif %}
    {% if r.basics.headline %}<p class="headline">{{ r.basics.headline }}</p>{% endif %}
    <div class="contact">
      {%- if r.basics.location %}<span>{{ r.basics.location }}</span>{% endif -%}
      {%- if r.basics.phone %}<span>{{ r.basics.phone }}</span>{% endif -%}
      {%- if r.basics.email %}<span><a href="mailto:{{ r.basics.email }}">{{ r.basics.email }}</a></span>{% endif -%}
      {%- for link in r.basics.links %}
        {%- if link.url %}<span><a href="{{ link.url | href }}">{{ link.label or link.url }}</a></span>{% endif -%}
      {%- endfor -%}
    </div>
    {% if r.basics.summary %}<p class="summary">{{ r.basics.summary }}</p>{% endif %}
  </header>

  {% for s in r.sections %}
  <section>
    <h2>{{ s.title or s.kind|title }}</h2>

    {% if s.kind == "skills" %}
      {% for item in s.items %}
      <div class="item tags">
        {% if item.tags %}
          <div class="tag-group">
            {% if item.title %}<span class="tag-label">{{ item.title }}:</span>{% endif %}
            <span>{{ item.tags|join(", ") }}</span>
          </div>
        {% elif item.title %}
          <div class="item-title">{{ item.title }}</div>
        {% endif %}
        {% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}
        {% if item.bullets %}
        <ul>{% for b in item.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
        {% endif %}
      </div>
      {% endfor %}

    {% else %}
      {% for item in s.items %}
      <div class="item">
        <div class="item-head">
          <div>
            <span class="item-title">
              {%- if item.url %}<a href="{{ item.url | href }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif -%}
            </span>
            {%- if item.subtitle %} — <span class="item-sub">{{ item.subtitle }}</span>{% endif -%}
          </div>
          {% set dates = item | daterange %}
          {% if dates or item.location %}
          <div class="item-meta">
            {{- dates -}}
            {%- if dates and item.location %} · {% endif -%}
            {{- item.location -}}
          </div>
          {% endif %}
        </div>
        {% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}
        {% if item.tags %}<p class="item-desc">{{ item.tags|join(", ") }}</p>{% endif %}
        {% if item.bullets %}
        <ul>{% for b in item.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>
        {% endif %}
      </div>
      {% endfor %}
    {% endif %}
  </section>
  {% endfor %}

</div>
</body>
</html>
